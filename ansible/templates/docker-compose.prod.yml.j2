x-back-image: &back-image "{{ docker_user }}/{{ docker_image_name }}:{{ docker_image_tag }}"

x-back-env: &back-env
  env_file:
    - .env

x-back-depends: &back-depends
  depends_on:
    db:
      condition: service_healthy

services:
  db:
    image: postgres:18
    container_name: roomie_match_db
    restart: unless-stopped
    env_file:
      - .env
    volumes:
      - postgres_data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U $$POSTGRES_USER -d $$POSTGRES_DB"]
      interval: 10s
      timeout: 5s
      retries: 5

  migrate:
    image: *back-image
    container_name: roomie_match_migrate
    restart: "no"
    <<: [*back-env, *back-depends]
    command: uv run alembic upgrade head

  bootstrap-rbac:
    image: *back-image
    container_name: roomie_match_bootstrap_rbac
    restart: "no"
    <<: [*back-env, *back-depends]
    depends_on:
      db:
        condition: service_healthy
      migrate:
        condition: service_completed_successfully
    command: uv run python scripts/bootstrap_rbac.py

  api:
    image: *back-image
    container_name: roomie_match_api
    restart: unless-stopped
    <<: [*back-env, *back-depends]
    depends_on:
      db:
        condition: service_healthy
      migrate:
        condition: service_completed_successfully
      bootstrap-rbac:
        condition: service_completed_successfully
    command: gunicorn app.main:app -c gunicorn.conf.py

  nginx:
    image: nginx:1.27-alpine
    container_name: roomie_match_nginx
    restart: unless-stopped
    depends_on:
      api:
        condition: service_started
    ports:
      - "80:80"
    volumes:
      - ./nginx.conf:/etc/nginx/conf.d/default.conf:ro
      - ./index.html:/usr/share/nginx/html/index.html:ro

volumes:
  postgres_data: